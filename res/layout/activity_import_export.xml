<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_export_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Export Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export Data"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_export_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_words"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_export_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_categories"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_export_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_all"
                android:textSize="16sp"
                android:background="@color/color_correct"
                android:textColor="@color/color_button_text"
                android:padding="14dp" />

        </LinearLayout>

        <!-- Import Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Data"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_import_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_words"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_import_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_categories"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_import_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_all"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_update_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_list"
                android:textSize="16sp"
                android:background="@android:color/holo_orange_dark"
                android:textColor="@color/color_button_text"
                android:padding="14dp" />

        </LinearLayout>

        <!-- Add Custom Word/Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:color/white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Custom Entry"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_add_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_word"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_add_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_category_name"
                android:textSize="16sp"
                android:background="@color/color_button_primary"
                android:textColor="@color/color_button_text"
                android:padding="14dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>