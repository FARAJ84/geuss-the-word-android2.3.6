<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:padding="8dp">

    <!-- Header with category and chances -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Category: All"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="left" />

        <TextView
            android:id="@+id/tv_chances"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chances: 5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            android:gravity="right" />

    </LinearLayout>

    <!-- Word length indicator -->
    <TextView
        android:id="@+id/tv_word_length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Word length: 5"
        android:textSize="14sp"
        android:textColor="@color/color_text_secondary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Guess Grid (5 rows) -->
    <LinearLayout
        android:id="@+id/ll_guess_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">
        <!-- Rows will be added programmatically -->
    </LinearLayout>

    <!-- Keyboard -->
    <LinearLayout
        android:id="@+id/ll_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <!-- Keyboard rows will be added programmatically -->
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/backspace"
            android:textSize="16sp"
            android:background="@color/color_button_primary"
            android:textColor="@color/color_button_text"
            android:padding="12dp"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/enter"
            android:textSize="16sp"
            android:background="@color/color_correct"
            android:textColor="@color/color_button_text"
            android:padding="12dp"
            android:layout_marginLeft="8dp" />

    </LinearLayout>

</LinearLayout>