<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wordle Style Game"
        android:textSize="16sp"
        android:textColor="@color/color_text_secondary"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_new_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_new_game"
        android:textSize="18sp"
        android:background="@color/color_button_primary"
        android:textColor="@color/color_button_text"
        android:layout_marginBottom="12dp"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_categories"
        android:textSize="18sp"
        android:background="@color/color_button_primary"
        android:textColor="@color/color_button_text"
        android:layout_marginBottom="12dp"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_import_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_import_export"
        android:textSize="18sp"
        android:background="@color/color_button_primary"
        android:textColor="@color/color_button_text"
        android:layout_marginBottom="12dp"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_settings"
        android:textSize="18sp"
        android:background="@color/color_button_primary"
        android:textColor="@color/color_button_text"
        android:layout_marginBottom="12dp"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_help"
        android:textSize="18sp"
        android:background="@android:color/transparent"
        android:textColor="@color/color_text_secondary"
        android:layout_marginBottom="12dp"
        android:padding="16dp" />

</LinearLayout>